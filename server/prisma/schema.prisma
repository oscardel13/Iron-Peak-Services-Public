generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DumpsterStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BookingStatus {
  QUOTE
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  DEPOSIT_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum ServiceType {
  DUMPSTER_RENTAL
  JUNK_REMOVAL
  DEMOLITION
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER
}

enum BookingActorType {
  ADMIN
  CUSTOMER_LINK
  SYSTEM
}

model Dumpster {
  id            String          @id @default(cuid())
  label         String
  size          Int
  sizeLabel     String
  serialNumber  String?         @unique
  color         String?
  status        DumpsterStatus  @default(AVAILABLE)
  notes         String?
  isActive      Boolean         @default(true)

  basePrice        Int     
  concretePrice    Int       

  bookings      Booking[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([size])
  @@index([status])
  @@index([isActive])
}

model Booking {
  id                        String         @id @default(cuid())
  bookingNumber             String         @unique

  dumpsterId                String?
  dumpster                  Dumpster?      @relation(fields: [dumpsterId], references: [id], onDelete: SetNull)

  dumpsterSize              Int
  dumpsterLabel             String?
  material                  String?

  serviceType               ServiceType    @default(DUMPSTER_RENTAL)
  projectType               String?

  customerName              String
  customerPhone             String
  customerEmail             String?

  address1                  String
  address2                  String?
  city                      String
  state                     String
  zip                       String

  latitude                  Decimal?       @db.Decimal(10, 7)
  longitude                 Decimal?       @db.Decimal(10, 7)
  distanceFromWarehouse     Decimal?       @db.Decimal(10, 2)

  placement                 String?
  instructions              String?
  customerNotes             String?

  locationVerified          Boolean        @default(false)
  locationVerificationNote  String?

  deliveryDate              DateTime
  pickupDate                DateTime?
  pickupDateUnknown         Boolean        @default(false)
  rentalDaysIncluded        Int            @default(7)

  priorityDelivery          Boolean   @default(false)
  deliveryTime              DateTime?
  priorityDeliveryNote      String?

  bookingStatus             BookingStatus  @default(QUOTE)
  paymentStatus             PaymentStatus  @default(UNPAID)

  stripePaymentIntentId     String? @unique
  stripePaymentStatus       String?
  paidAt                    DateTime?
  confirmedAt               DateTime?

  basePrice                 Decimal        @db.Decimal(10, 2)
  deliveryFee               Decimal        @default(0) @db.Decimal(10, 2)
  mileageFee                Decimal        @default(0) @db.Decimal(10, 2)
  extraDaysFee              Decimal        @default(0) @db.Decimal(10, 2)
  overageFee                Decimal        @default(0) @db.Decimal(10, 2)
  addonsTotal               Decimal        @default(0) @db.Decimal(10, 2)
  total                     Decimal        @db.Decimal(10, 2)

  quotedAt                  DateTime?
  scheduledAt               DateTime?
  deliveredAt               DateTime?
  pickedUpAt                DateTime?
  cancelledAt               DateTime?
  completedAt               DateTime?

  addons                    BookingAddon[]
  notes                     BookingNote[]
  history                   BookingHistory[]
  accessTokens              CustomerAccessToken[]

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([deliveryDate])
  @@index([pickupDate])
  @@index([serviceType])
  @@index([dumpsterId])
  @@index([customerEmail])
  @@index([bookingNumber])
  @@index([zip])
}

model Addon {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  isActive    Boolean        @default(true)

  bookingAddons BookingAddon[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model BookingAddon {
  id                String   @id @default(cuid())
  bookingId         String
  addonId           String

  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addon             Addon    @relation(fields: [addonId], references: [id], onDelete: Restrict)

  addonCodeSnapshot String
  addonNameSnapshot String
  addonPriceSnapshot Decimal  @db.Decimal(10, 2)
  quantity          Int      @default(1)

  createdAt         DateTime @default(now())

  @@index([bookingId])
  @@index([addonId])
}

model BookingNote {
  id          String         @id @default(cuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  visibility  NoteVisibility @default(INTERNAL)
  body        String

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([bookingId])
  @@index([visibility])
}

model BookingHistory {
  id          String           @id @default(cuid())
  bookingId   String
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  eventType   String
  actorType   BookingActorType
  actorLabel  String?
  summary     String
  metadata    Json?

  createdAt   DateTime         @default(now())

  @@index([bookingId])
  @@index([eventType])
  @@index([createdAt])
}

model CustomerAccessToken {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  tokenHash   String   @unique
  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([expiresAt])
}

enum AccessLevel {
  CLIENT
  DRIVER
  WORKER
  ADMIN
  OWNER
}

enum AuthProviderType {
  GOOGLE
  META
  X
  EMAIL
}

model User {
  id           String       @id @default(cuid())

  name         String?
  email        String?      @unique
  phone        String?
  picture      String?

  accessLevel  AccessLevel  @default(CLIENT)
  isActive     Boolean      @default(true)

  authProviders UserAuthProvider[]

  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([email])
  @@index([accessLevel])
  @@index([isActive])
}

model UserAuthProvider {
  id                 String           @id @default(cuid())

  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider           AuthProviderType
  providerAccountId  String
  email              String?
  username           String?
  name               String?
  picture            String?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
}